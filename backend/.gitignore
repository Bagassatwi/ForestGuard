# ==========================================
# Flask & Python Specifics
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Flask instance folder (contains app configurations/secrets specific to this machine)
instance/

# Flask-WebAssets cache
.webassets-cache

# ==========================================
# Virtual Environments (DO NOT COMMIT)
# ==========================================
.venv/
venv/
ENV/
env/
virtualenv/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.flaskenv
*.env
*.secret

# ==========================================
# Databases (If using SQLite locally)
# ==========================================
*.db
*.sqlite3

